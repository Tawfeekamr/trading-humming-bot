# NautilusTrader requires Python >=3.12
FROM python:3.12-slim-bookworm

# Install build dependencies for NautilusTrader's Cython/Rust core
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain (required by nautilus_trader Rust extensions)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /app

# Upgrade build tools
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install NautilusTrader with Interactive Brokers adapter + MQTT client
RUN pip install --no-cache-dir \
    "nautilus_trader[ib]>=1.227.0" \
    paho-mqtt>=2.0 \
    aiohttp>=3.9 \
    pyyaml>=6.0 \
    pandas>=2.0

# Copy nautilus package source
COPY src/nautilus/ /app/src/nautilus/
COPY config/nautilus.yaml /app/config/nautilus.yaml

# Ensure src is importable
ENV PYTHONPATH=/app/src:/app
ENV NAUTILUS_CONFIG_PATH=/app/config/nautilus.yaml

# Health check — verify the package imports without starting the node
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "from src.nautilus.config import load_config; load_config()" || exit 1

CMD ["python", "-m", "src.nautilus.main"]

# ════════════════════════════════════════════════════════════════════
#  TA-Enhanced BTC/USDT Grid Bot — Environment Variables
#
#  LOCAL: Copy this file to .env and fill in your real values.
#  RAILWAY: Paste each variable directly in Railway → Variables tab.
#           Never upload .env to GitHub or Railway directly.
#
#  NEVER commit .env to Git — it contains your private API keys.
# ════════════════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════════════════
#  RAILWAY DEPLOYMENT
#  Do NOT upload this file to Railway.
#  Instead, go to: Railway → Your Project → Variables → Raw Editor
#  Then paste each key=value pair below directly into the editor.
# ════════════════════════════════════════════════════════════════════

RAILWAY_REGION=us-west2          # Railway auto-assigns, you can leave blank


# ── BINANCE FZE (Primary Exchange) ──────────────────────────────────
# Get your API key from: https://www.binance.com/en/my/settings/api-management
# Required permissions: Enable Reading + Enable Spot & Margin Trading
# DISABLE: Enable Withdrawals (never needed by bot)
# ENABLE: IP restriction — whitelist your server IP only

BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Optional: Ed25519 private key for ultra-fast request signing (<0.05ms)
# Generate with: openssl genpkey -algorithm ed25519 -out keys/ed25519_private.pem
# Leave blank to use standard HMAC-SHA256 signing
BINANCE_ED25519_KEY_PATH=

# ── BINANCE TESTNET (Paper Trading) ─────────────────────────────────
# Register and get testnet keys from: https://testnet.binance.vision
# Used when ENV=paper — real market data, fake money

BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here


# ── OKX MIDDLE EAST (Failover Exchange) ─────────────────────────────
# Get your API key from: https://www.okx.com/account/users/personal-center/api
# Required permissions: Read + Trade
# Optional — only needed for failover or multi-exchange features

OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_PASSPHRASE=your_okx_api_passphrase_here

# Set to 1 to enable OKX demo/paper trading mode
# Set to 0 for live trading
OKX_DEMO_MODE=1


# ── TELEGRAM NOTIFICATIONS ──────────────────────────────────────────
# Step 1: Message @BotFather on Telegram → /newbot → copy the token
# Step 2: Message @userinfobot on Telegram → copy your Chat ID

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# ── STREAMLIT DASHBOARD ──────────────────────────────────────────────
# No keys needed — reads from local SQLite database
# Run locally:  streamlit run src/dashboard/app.py
# Railway URL:  set in Railway service settings (auto-assigned)

DASHBOARD_PORT=8501
# paper = use testnet keys, no real money
# live  = use real Binance keys, real money (only after testing!)
ENV=paper

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# ── GRID STRATEGY PARAMETERS ────────────────────────────────────────
# These override the defaults in config/strategy.yaml

# Total USDT capital to deploy in the grid
# Recommendation: Start with $200–500 during testing
GRID_CAPITAL_USDT=1000

# Number of grid levels (buy + sell orders on each side of mid price)
# More levels = more trades but smaller profit per trade
# Recommended range: 5–20
GRID_LEVELS=10

# ── RISK MANAGEMENT ─────────────────────────────────────────────────
# Bot halts automatically if portfolio drawdown exceeds this %
# Recommended: 10% for beginners, 15% for experienced traders
MAX_DRAWDOWN_PCT=10

# USDT amount always kept in reserve — never deployed in grid orders
# This is your safety buffer
MIN_USDT_RESERVE=100

# Maximum % of capital that can be in BTC at any time
# Prevents full exposure during sudden market drops
MAX_BTC_EXPOSURE_PCT=80

# ════════════════════════════════════════════════════════════════════
#  SECURITY CHECKLIST before going live:
#  ✅ API key has TRADE permission only (no withdrawals)
#  ✅ IP whitelist enabled on Binance API settings
#  ✅ .env is listed in .gitignore
#  ✅ Separate keys for testnet vs live
#  ✅ Ed25519 key stored in /keys/ (gitignored folder)
#  ✅ Rotate API keys every 90 days
# ════════════════════════════════════════════════════════════════════

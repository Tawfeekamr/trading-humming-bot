# ════════════════════════════════════════════════════════════════════
#  TA-Enhanced BTC/USDT Grid Bot — Secrets & Environment
#
#  This file contains ONLY secrets and deployment mode.
#  Strategy settings (grid levels, indicators, risk) → config/strategy.yaml
#  NEVER commit .env to Git — only commit this .env.example template.
# ════════════════════════════════════════════════════════════════════


# ── MODE ────────────────────────────────────────────────────────────
# paper = testnet keys, fake money  |  live = real Binance keys
ENV=paper
LOG_LEVEL=INFO


# ── BINANCE FZE (Live Trading) ──────────────────────────────────────
# Get keys from: https://www.binance.com/en/my/settings/api-management
# Permissions: Enable Reading + Enable Spot & Margin Trading
# DISABLE: Withdrawals  |  ENABLE: IP whitelist
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Optional: Ed25519 key path for faster signing (leave blank for HMAC)
# Generate: openssl genpkey -algorithm ed25519 -out keys/ed25519_private.pem
BINANCE_ED25519_KEY_PATH=


# ── BINANCE TESTNET (Paper Trading) ─────────────────────────────────
# Get keys from: https://testnet.binance.vision
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here


# ── TELEGRAM NOTIFICATIONS ──────────────────────────────────────────
# @BotFather → /newbot → copy token  |  @userinfobot → copy chat ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# ── DASHBOARD AUTH ──────────────────────────────────────────────────
# Generate hash:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
DASHBOARD_USERNAME=amro
DASHBOARD_PASSWORD_HASH=your_bcrypt_hash_here


# ════════════════════════════════════════════════════════════════════
#  SECURITY CHECKLIST before going live:
#  ✅ API key has TRADE permission only (no withdrawals)
#  ✅ IP whitelist enabled on Binance API settings
#  ✅ .env is listed in .gitignore
#  ✅ Separate keys for testnet vs live
#  ✅ Ed25519 key stored in /keys/ (gitignored folder)
#  ✅ Rotate API keys every 90 days
# ════════════════════════════════════════════════════════════════════

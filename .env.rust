# Rust Trading Engine environment
# Loaded by docker-compose.hybrid.yml → rust-engine service

# Exchange keys (loaded from .env via python-dotenv in current setup)
# For the Rust engine, these point to the env var NAMES that contain the actual keys
BINANCE_API_KEY_ENV=BINANCE_API_KEY
BINANCE_API_SECRET_ENV=BINANCE_API_SECRET

# Logging
RUST_LOG=info

# API server port
API_PORT=3030

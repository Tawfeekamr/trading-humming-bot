# ════════════════════════════════════════════════════════════════════
# Hybrid Dockerfile — Python signal listener WITHOUT Hummingbot and WITHOUT
# the Rust PyO3 wheel. Talks to the Rust trading engine via HTTP API for all
# exchange ops.
#
# The listener never imports `trading_engine_core`, so the Stage-1 Rust wheel
# build this image used to carry (~2-3 min of CI per deploy) was pure waste.
# It also needs only a small subset of requirements.txt (see
# requirements.signal.txt), not the full ML/Hummingbot dep set.
# ════════════════════════════════════════════════════════════════════

FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install only the deps the signal listener actually imports.
COPY requirements.signal.txt /tmp/requirements.signal.txt
RUN pip install --no-cache-dir -r /tmp/requirements.signal.txt && rm /tmp/requirements.signal.txt

# Copy Python source modules
COPY src/ /app/src/

# Copy utility scripts
COPY scripts/ /app/scripts/

# Ensure data/logs/config dirs exist (mounted as volumes at runtime)
RUN mkdir -p /app/data /app/logs /app/config

# Default: use Rust engine for execution
ENV EXECUTION_MODE=rust
ENV RUST_ENGINE_URL=http://rust-engine:3030
ENV PYTHONPATH=/app

ENTRYPOINT ["python", "-m", "src.run_signal_listener"]
